# Spec: Genesis Markdown/10-Architecture/Config And Secrets.md
#
# Secrets in env, behaviour in config. Never an API key in config.yaml, and never
# a behaviour flag in here.
#
# Copy to ~/.genesis/.env and lock it down — the loader refuses anything looser:
#     cp .env.example ~/.genesis/.env && chmod 600 ~/.genesis/.env
#
# These values are never logged, never written to the vault, and never sent to an
# LLM. genesis.observability.redactor scrubs them before anything reaches disk.

# Voice Stack — ElevenLabs STT (Scribe) and streaming TTS
ELEVENLABS_API_KEY=

# LLM Model Tiers — large and vision tiers
ANTHROPIC_API_KEY=
# Required ONLY if the key above is identity-linked (console-issued keys tied to
# a user identity): the id of the workspace requests act in. Without it every
# call is a 400 that reads like a malformed body. Ordinary keys must leave this
# blank — sending the header with a non-identity key is itself an error.
ANTHROPIC_WORKSPACE_ID=

# LLM Model Tiers §Development tiers — free providers for development only.
#
# These exist so that exercising the orchestrator does not bill the Anthropic
# account for testing plumbing. Google trains on free-tier prompts, so these
# must never see a live thesis, position or P&L: `_tier_backend` refuses to
# build them when brokers.primary.mode is `live`.
#
# Select the profile with GENESIS_CONFIG rather than editing the tier table:
#   cp config-dev.example.yaml ~/.genesis/config-dev.yaml
#   GENESIS_CONFIG=~/.genesis/config-dev.yaml genesis config check
#
# https://aistudio.google.com/apikey — free, no card, ~15 rpm / 1500 per day
GEMINI_API_KEY=
# https://console.groq.com/keys
GROQ_API_KEY=
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Agent — Broker Adapter. PAPER keys only in this file.
# Live keys live in a SEPARATE env file: switching brokers.primary.mode to `live`
# requires both the config change and the live key present. Two independent
# actions to go live — never one flag.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Market-data MCPs
MARKET_DATA_API_KEY=

# Agent — News And Catalyst
NEWS_API_KEY=

# Web search — MCP Server Catalog.md §web. Key from dashboard.exa.ai.
# Without it the exa server is simply unavailable and everything else still
# runs: `genesis mcp check` reports it as down rather than failing to start.
EXA_API_KEY=

# --- Filings, macro, documents (MCP Server Catalog.md) ---------------------

# SEC EDGAR asks every client to identify itself with a name and an email so it
# can contact whoever is generating traffic. NOT a secret — it is here because
# this file is the one channel the config layer reads environment from. EDGAR
# answers an anonymous client with a 403 that reads like an outage.
#   Format: "Your Name your@email.com"
SEC_EDGAR_USER_AGENT=

# St. Louis Fed. Free, instant, no approval step: fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# GitHub, for repository state and — later, separately granted — filing a
# defect. The shipped config points at GitHub's hosted read-only endpoint, so a
# token with `repo` read scope is all this needs. Without it the server answers
# 401 and registers nothing; `genesis mcp check` says so.
GITHUB_PERSONAL_ACCESS_TOKEN=

# --- Market data: free, and mostly keyless ---------------------------------
#
# The posture is Market Data Plane's own: v1 needs no live feed. Genesis is an
# analyst, not an execution bot, so the expensive axis (latency) is worth almost
# nothing and the cheap axes (depth, breadth, primary documents) are the ones
# that matter. All three are free.
#
# NO KEY AT ALL — wired and working, nothing to do here:
#   yfinance   20 years of daily bars, statements, dividends, splits, ratings
#   openbb     earnings/dividend/split/IPO/econ calendars, forward estimates,
#              discovery screens, OECD & IMF macro
#   maverick   stock screening and technical analysis
#
# Three of those run from a clone rather than PyPI:
#   git clone https://github.com/barvhaim/yfinance-mcp-server   ~/.genesis/mcp-servers/yfinance-mcp-server
#   git clone https://github.com/wshobson/maverick-mcp          ~/.genesis/mcp-servers/maverick-mcp
#   git clone https://github.com/sverze/stock-market-mcp-server ~/.genesis/mcp-servers/stock-market-mcp-server

# finnhub.io — FREE key, one signup. Brings market-wide news (the only
# genuinely market-wide feed wired) and basic financial metrics.
FINNHUB_API_KEY=

# --- Historical futures: Databento ------------------------------------------
#
# Open Questions §6 (2026-09-04). Bought as HISTORICAL ONLY, on free signup
# credits, and it exists because the live feed cannot serve backtests: IBKR
# drops expired futures contracts more than two years past expiry, and paces
# its historical endpoint at 60 requests per 10 minutes. Databento has the CME
# archive at full depth with no pacing wall.
#
# This is the split the whole plane is shaped around -- Databento for history,
# the broker for live -- and it is the reason Market Data Plane has an adapter
# layer rather than one hardcoded vendor.
#
# Free key, instant, no card: databento.com/signup. Keys start `db-`.
# Without it the databento adapter is simply unavailable; the store still
# answers from whatever history it already holds, and yfinance still covers
# equities and daily. Nothing fabricates a bar to cover the gap.
DATABENTO_API_KEY=

# --- Interactive Brokers: the tier-1 feed ----------------------------------
#
# Open Questions §1 (2026-09-04). IBKR is the broker and CME futures are the
# asset class: the non-professional US futures data bundle is ~$10/month, often
# waived by commissions, and it delivers data and execution over ONE connection
# -- so charts, signals and fills cannot disagree with each other.
#
# These are read by deploy/ib-gateway/docker-compose.yml, which runs IB Gateway
# headless with IBC handling the login and the mandatory daily restart:
#
#   cd deploy/ib-gateway && docker compose --env-file ~/.genesis/.env up -d
#
# Genesis reads IB_USERID only, to show which login is in use. IB_PASSWORD is
# read by the gateway container and nothing else.
IB_USERID=
IB_PASSWORD=

# paper | live. Stays `paper` until Phase 7 deliberately changes it.
# Safety Invariants §5: never ship a default that trades unattended.
IB_TRADING_MODE=paper

# 4002 = Gateway paper, 4001 = Gateway live. Loopback-bound in compose.
IB_GATEWAY_PORT=4002

# READ-ONLY API. Leave this `yes`.
#
# It makes the socket structurally incapable of placing an order -- afferent ≠
# efferent enforced by the broker rather than by our convention, which is
# stronger than the same rule in Python because it survives a bug in our code.
# The market data plane is read-only and never needs this off. Phase 7 gets its
# own connection and its own decision.
IB_READ_ONLY_API=yes

# VNC, needed once to set the API options in the gateway GUI. Blank leaves the
# VNC server off, which is the right default -- see deploy/ib-gateway/README.md.
VNC_SERVER_PASSWORD=

# --- Superseded or paid: configured, off -----------------------------------
#
# alphavantage.co — SUPERSEDED by openbb. Its unique value was the earnings
# calendar at 25 calls a DAY; openbb serves the same calendar free and
# unmetered. Kept only as a written fallback route.
ALPHAVANTAGE_API_KEY=
# financialdatasets.ai — PAID, and every one of its tools is free elsewhere:
# statements from openbb, prices from yfinance, filings from sec-edgar.
FINANCIAL_DATASETS_API_KEY=
#
# NOT here on purpose: ALPACA_TOOLSETS. It decides which tools alpaca-mcp-server
# exposes at all, which makes it the first of three locks on the order path —
# behaviour, not a credential. A safety decision in a shell profile is one
# nobody reviews, so it lives in default_servers.yaml under `env:`.
