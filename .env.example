# Spec: Genesis Markdown/10-Architecture/Config And Secrets.md
#
# Secrets in env, behaviour in config. Never an API key in config.yaml, and never
# a behaviour flag in here.
#
# Copy to ~/.genesis/.env and lock it down — the loader refuses anything looser:
#     cp .env.example ~/.genesis/.env && chmod 600 ~/.genesis/.env
#
# These values are never logged, never written to the vault, and never sent to an
# LLM. genesis.observability.redactor scrubs them before anything reaches disk.

# Voice Stack — ElevenLabs STT (Scribe) and streaming TTS
ELEVENLABS_API_KEY=

# LLM Model Tiers — large and vision tiers
ANTHROPIC_API_KEY=

# Agent — Broker Adapter. PAPER keys only in this file.
# Live keys live in a SEPARATE env file: switching brokers.primary.mode to `live`
# requires both the config change and the live key present. Two independent
# actions to go live — never one flag.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Market-data MCPs
MARKET_DATA_API_KEY=

# Agent — News And Catalyst
NEWS_API_KEY=
