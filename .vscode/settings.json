{
  // corpus/ is a symlink to 22 GB on the SSD; .venv and node_modules are another 1.3 GB.
  // Letting the watcher, search, or Pylance walk them is what takes VS Code down.
  "files.watcherExclude": {
    "**/corpus/**": true,
    "**/.venv/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/__pycache__/**": true,
    "**/.pytest_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/.git/objects/**": true
  },
  "search.exclude": {
    "**/corpus": true,
    "**/.venv": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "INDEX.auto.md": true
  },
  "search.followSymlinks": false,
  "python.analysis.exclude": ["corpus", "ui", ".venv", "evals", "**/__pycache__"],
  "python.analysis.indexing": false
}
